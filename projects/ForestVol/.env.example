# Puertos de servicio
BACKEND_PORT=8000
FRONTEND_PORT=3000
NODEODM_PORT=3001
FRONTEND_API_BASE_URL=http://localhost:8000

# Restricciones de carga
MIN_IMAGES=10
MAX_IMAGES=50
MAX_IMAGE_SIZE_MB=20
MAX_SESSION_SIZE_GB=1

# Rutas de datos
UPLOAD_PATH=data/uploads
PROCESSED_PATH=data/processed
EXPORT_PATH=data/exports

# NodeODM
NODEODM_URL=http://nodeodm:3000
NODEODM_TIMEOUT_SECONDS=1800
NODEODM_DATA_PATH=/nodeodm-data

# Calibracion
CALIBRATION_CONFIDENCE_THRESHOLD=0.90
CALIBRATION_MARKER_SIZE_CM=100.0

# Version
FORESTVOL_VERSION=5.1
